<%- include('../partials/head', { title: 'Crear cuenta', description: 'Crea tu cuenta en Competency Hub.' }) %>
<main id="main" class="auth-layout">
  <div class="auth-shell">
    <%- include('../partials/auth-aside') %>

    <section class="auth-panel" aria-labelledby="register-title">
      <header class="auth-header">
        <span class="auth-header-icon"><%- include('../partials/icon', { name: 'user-plus', size: 24, label: null }) %></span>
        <h1 id="register-title">Crear cuenta</h1>
        <p>Regístrate para acceder al catálogo de skills y al chat del equipo.</p>
      </header>

      <%- include('../partials/alert', { type: 'error', title: 'No pudimos crear tu cuenta', messages: errors }) %>

      <form class="form" action="/auth/register" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="name">Nombre completo</label>
          <input class="form-control" id="name" name="name" type="text"
            value="<%= old.name || '' %>" autocomplete="name" placeholder="Ej. Ana Torres" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Correo electrónico</label>
          <input class="form-control" id="email" name="email" type="email"
            value="<%= old.email || '' %>" autocomplete="email" placeholder="nombre@empresa.com" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Contraseña</label>
          <input class="form-control" id="password" name="password" type="password"
            autocomplete="new-password" aria-describedby="password-hint" required>
          <span class="form-hint" id="password-hint">Entre 8 y 64 caracteres, con al menos una mayúscula y un número.</span>
        </div>

        <button class="btn btn-primary btn-block" type="submit">Crear cuenta</button>
      </form>

      <p class="auth-switch">¿Ya tienes cuenta? <a href="/auth/login">Inicia sesión</a></p>
    </section>
  </div>
</main>
<%- include('../partials/footer') %>
