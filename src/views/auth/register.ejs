<%- include('../partials/head', { title: 'Crear cuenta' }) %>
<main id="main" class="main">
<div class="container">
  <h1>Crear cuenta</h1>
  <% if (errors.length) { %>
    <ul><% errors.forEach(e => { %><li style="color:red;"><%= e.msg %></li><% }) %></ul>
  <% } %>
  <form action="/auth/register" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label>Nombre: <input type="text" name="name" value="<%= old.name || '' %>" required></label></div>
    <div><label>Email: <input type="email" name="email" value="<%= old.email || '' %>" required></label></div>
    <div><label>Contraseña: <input type="password" name="password" required></label></div>
    <button type="submit">Registrarse</button>
  </form>
  <p><a href="/auth/login">¿Ya tienes cuenta? Inicia sesión</a></p>
</div>
</main>
<%- include('../partials/footer') %>
