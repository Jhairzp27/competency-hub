<%- include('../partials/head', { title: 'Crear cuenta', description: 'Crea tu cuenta en Competency Hub.' }) %>
<main id="main" class="auth-layout">
  <div class="auth-shell">
    <%- include('../partials/auth-aside') %>

    <section class="auth-panel" aria-labelledby="register-title">
      <header class="auth-header">
        <span class="auth-header-icon"><%- include('../partials/icon', { name: 'user-plus', size: 24, label: null }) %></span>
        <h1 id="register-title">Crear cuenta</h1>
        <p>Regístrate para acceder al catálogo de skills y al chat del equipo.</p>
      </header>

      <%- include('../partials/alert', { type: 'error', title: 'No pudimos crear tu cuenta', messages: errors }) %>

      <form class="form" action="/auth/register" method="POST" data-validate data-error-summary>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="name">Nombre completo</label>
          <input class="form-control" id="name" name="name" type="text"
            value="<%= old.name || '' %>" autocomplete="name" placeholder="Ej. Ana Torres" required minlength="3" maxlength="100"
            data-msg-required="El nombre es obligatorio."
            data-msg-length="El nombre debe tener entre 3 y 100 caracteres.">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Correo electrónico</label>
          <input class="form-control" id="email" name="email" type="email"
            value="<%= old.email || '' %>" autocomplete="email" placeholder="nombre@empresa.com" required maxlength="150"
            data-msg-required="Ingresa tu correo electrónico."
            data-msg-email="Ingresa un correo electrónico válido."
            data-msg-maxlength="El correo debe tener como máximo 150 caracteres.">
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Contraseña</label>
          <input class="form-control" id="password" name="password" type="password"
            autocomplete="new-password" aria-describedby="password-requirements"
            required minlength="8" maxlength="64" data-rule-uppercase data-rule-digit
            data-msg-required="La contraseña es obligatoria."
            data-msg-length="La contraseña debe tener entre 8 y 64 caracteres."
            data-msg-uppercase="La contraseña debe incluir al menos una letra mayúscula."
            data-msg-digit="La contraseña debe incluir al menos un número.">
          <%- include('../partials/password-checklist', { inputId: 'password' }) %>
        </div>

        <button class="btn btn-primary btn-block" type="submit">Crear cuenta</button>
      </form>

      <p class="auth-switch">¿Ya tienes cuenta? <a href="/auth/login">Inicia sesión</a></p>
    </section>
  </div>
</main>
<%- include('../partials/footer', { scripts: ['/js/form-validation.js', '/js/password-checklist.js'] }) %>
