<%- include('../partials/head', { title: 'Iniciar sesión', description: 'Inicia sesión en Competency Hub para gestionar el catálogo de skills de tu equipo.' }) %>
<main id="main" class="auth-layout">
  <div class="auth-shell">
    <%- include('../partials/auth-aside') %>

    <section class="auth-panel" aria-labelledby="login-title">
      <header class="auth-header">
        <span class="auth-header-icon"><%- include('../partials/icon', { name: 'log-in', size: 24, label: null }) %></span>
        <h1 id="login-title">Iniciar sesión</h1>
        <p>Ingresa con tu correo y contraseña.</p>
      </header>

      <%- include('../partials/alert', { type: 'success', messages: message }) %>
      <%- include('../partials/alert', { type: 'error', title: 'No pudimos iniciar sesión', messages: errors }) %>

      <form class="form" action="/auth/login" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="email">Correo electrónico</label>
          <input class="form-control" id="email" name="email" type="email"
            value="<%= old.email || '' %>" autocomplete="email" placeholder="nombre@empresa.com" required maxlength="150"
            data-msg-required="Ingresa tu correo electrónico."
            data-msg-email="Ingresa un correo electrónico válido."
            data-msg-maxlength="El correo debe tener como máximo 150 caracteres.">
        </div>

        <div class="form-group">
          <div class="form-label-row">
            <label class="form-label" for="password">Contraseña</label>
            <a href="/auth/forgot">¿Olvidaste tu contraseña?</a>
          </div>
          <input class="form-control" id="password" name="password" type="password"
            autocomplete="current-password" required
            data-msg-required="La contraseña es obligatoria.">
        </div>

        <button class="btn btn-primary btn-block" type="submit">Entrar</button>
      </form>

      <p class="auth-switch">¿No tienes cuenta? <a href="/auth/register">Crear cuenta</a></p>
    </section>
  </div>
</main>
<%- include('../partials/footer', { scripts: ['/js/form-validation.js'] }) %>
