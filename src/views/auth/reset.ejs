<%- include('../partials/head', { title: 'Nueva contraseña', description: 'Establece una nueva contraseña para tu cuenta de Competency Hub.' }) %>
<main id="main" class="auth-layout">
  <div class="auth-shell">
    <%- include('../partials/auth-aside') %>

    <section class="auth-panel" aria-labelledby="reset-title">
      <header class="auth-header">
        <span class="auth-header-icon"><%- include('../partials/icon', { name: 'lock', size: 24, label: null }) %></span>
        <h1 id="reset-title">Nueva contraseña</h1>
        <p>Elige una contraseña segura que no hayas usado antes.</p>
      </header>

      <%- include('../partials/alert', { type: 'error', title: 'No pudimos actualizar la contraseña', messages: errors }) %>

      <form class="form" action="/auth/reset/<%= token %>" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="password">Nueva contraseña</label>
          <input class="form-control" id="password" name="password" type="password"
            autocomplete="new-password" aria-describedby="password-hint"
            required minlength="8" maxlength="64" data-rule-uppercase data-rule-digit
            data-msg-required="La nueva contraseña es obligatoria."
            data-msg-length="La nueva contraseña debe tener entre 8 y 64 caracteres."
            data-msg-uppercase="Debe incluir al menos una letra mayúscula."
            data-msg-digit="Debe incluir al menos un número.">
          <span class="form-hint" id="password-hint">Entre 8 y 64 caracteres, con al menos una mayúscula y un número.</span>
        </div>

        <button class="btn btn-primary btn-block" type="submit">Guardar nueva contraseña</button>
      </form>

      <p class="auth-switch">
        <a href="/auth/login"><%- include('../partials/icon', { name: 'arrow-left', size: 16, label: null }) %> Volver a iniciar sesión</a>
      </p>
    </section>
  </div>
</main>
<%- include('../partials/footer', { scripts: ['/js/form-validation.js'] }) %>
