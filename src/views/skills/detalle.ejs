<%- include('../partials/head', { title: skill.nombre }) %>
<main id="main" class="main">
<div class="container stack">
  <a class="back-link" href="/skills"><%- include('../partials/icon', { name: 'arrow-left', size: 18, label: null }) %> Volver al catálogo</a>

  <%- include('../partials/flash') %>

  <article class="card stack" aria-labelledby="skill-titulo">
    <header class="page-header detail-header">
      <h1 id="skill-titulo"><%= skill.nombre %></h1>
      <p class="cluster">
        <span class="badge <%= skill.categoria === 'TECNICA' ? 'badge-technical' : 'badge-behavioral' %>"><%= etiquetaCategoria(skill.categoria) %></span>
        <span class="badge<%= skill.importancia === 'CRITICA' ? ' badge-critical' : skill.importancia === 'ALTA' ? ' badge-high' : '' %>">Importancia: <%= etiquetaImportancia(skill.importancia) %></span>
      </p>
    </header>

    <dl class="detail-list">
      <div class="detail-item detail-item-wide">
        <dt>Descripción</dt>
        <dd class="detail-text"><%= skill.descripcion %></dd>
      </div>
      <div class="detail-item">
        <dt>Nivel esperado</dt>
        <dd><%- include('../partials/level', { level: skill.nivelEsperado }) %></dd>
      </div>
      <div class="detail-item">
        <dt>Registrada por</dt>
        <dd><%= skill.createdBy ? skill.createdBy.name : 'Catálogo base' %></dd>
      </div>
      <div class="detail-item">
        <dt>Creada</dt>
        <dd><time datetime="<%= skill.createdAt.toISOString() %>"><%= formatearFecha(skill.createdAt) %></time></dd>
      </div>
      <div class="detail-item">
        <dt>Última actualización</dt>
        <dd><time datetime="<%= skill.updatedAt.toISOString() %>"><%= formatearFecha(skill.updatedAt) %></time></dd>
      </div>
    </dl>

    <div class="cluster detail-actions">
      <a class="btn btn-primary" href="/skills/<%= skill.id %>/editar">
        <%- include('../partials/icon', { name: 'pencil', label: null }) %>
        <span>Editar</span>
      </a>
      <a class="btn btn-danger" href="/skills/<%= skill.id %>/eliminar"
        data-confirm
        data-confirm-action="/skills/<%= skill.id %>/eliminar"
        data-confirm-title="¿Eliminar la skill «<%= skill.nombre %>»?"
        data-confirm-message="Se eliminará del catálogo. Esta acción no se puede deshacer."
        data-confirm-label="Eliminar">
        <%- include('../partials/icon', { name: 'trash', label: null }) %>
        <span>Eliminar</span>
      </a>
    </div>
  </article>
</div>
</main>
<%- include('../partials/confirm-dialog') %>
<%- include('../partials/footer', { scripts: ['/js/confirm-dialog.js'] }) %>
