<%- include('../partials/head', { title: 'Catálogo de skills' }) %>
<main id="main" class="main">
<div class="container stack">
  <header class="page-header">
    <h1>Catálogo de skills</h1>
    <p>Competencias técnicas y conductuales que la consultora espera de su equipo.</p>
  </header>

  <%- include('../partials/flash') %>

  <% if (items.length) { %>
    <div class="table-wrapper">
      <table class="table">
        <caption class="sr-only">Skills del catálogo, página <%= page %> de <%= totalPages %></caption>
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Categoría</th>
            <th scope="col">Nivel esperado</th>
            <th scope="col">Importancia</th>
            <th scope="col" class="cell-actions"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((skill) => { %>
            <tr>
              <td class="cell-title"><a href="/skills/<%= skill.id %>"><%= skill.nombre %></a></td>
              <td><span class="badge <%= skill.categoria === 'TECNICA' ? 'badge-technical' : 'badge-behavioral' %>"><%= etiquetaCategoria(skill.categoria) %></span></td>
              <td><%- include('../partials/level', { level: skill.nivelEsperado }) %></td>
              <td><span class="badge<%= ['ALTA', 'CRITICA'].includes(skill.importancia) ? ' badge-high' : '' %>"><%= etiquetaImportancia(skill.importancia) %></span></td>
              <td class="cell-actions">
                <div class="table-actions">
                  <a class="btn btn-ghost btn-icon" href="/skills/<%= skill.id %>" aria-label="Ver <%= skill.nombre %>"><%- include('../partials/icon', { name: 'eye', label: null }) %></a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%- include('../partials/pagination', { page, totalPages, totalItems, pageSize, baseUrl: '/skills', query }) %>
  <% } else { %>
    <div class="card">
      <div class="empty-state">
        <%- include('../partials/icon', { name: 'search', size: 40, label: null }) %>
        <h3>No se encontraron skills</h3>
        <p>Todavía no hay skills en el catálogo.</p>
      </div>
    </div>
  <% } %>
</div>
</main>
<%- include('../partials/footer') %>
