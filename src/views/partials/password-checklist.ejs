<%#
  Partial: requisitos de contraseña que se marcan mientras el usuario escribe.
  Uso (debajo del input de contraseña):
    include('../partials/password-checklist', { inputId: 'password' })
  y cargar '/js/password-checklist.js' en el footer.
  El input debe tener aria-describedby="<inputId>-requirements".
  Las reglas coinciden con auth.validators.js (8-64 caracteres, una mayúscula, un número).
%>
<ul class="password-checklist" id="<%= locals.inputId || 'password' %>-requirements" data-password-checklist="<%= locals.inputId || 'password' %>">
  <li data-check="length"><span class="check-icon" aria-hidden="true"></span><span>Entre 8 y 64 caracteres</span><span class="sr-only check-state">(pendiente)</span></li>
  <li data-check="uppercase"><span class="check-icon" aria-hidden="true"></span><span>Al menos una letra mayúscula</span><span class="sr-only check-state">(pendiente)</span></li>
  <li data-check="digit"><span class="check-icon" aria-hidden="true"></span><span>Al menos un número</span><span class="sr-only check-state">(pendiente)</span></li>
</ul>
