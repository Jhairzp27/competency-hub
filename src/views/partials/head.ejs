<%#
  Partial: cabecera HTML común a todas las vistas.
  Uso (desde una vista): include('../partials/head', { title: 'Iniciar sesión' })
  Variables opcionales:
    - title:       título de la pestaña (se le añade « · Competency Hub»)
    - description: meta description de la página
    - bodyClass:   clase para <body> (ej. 'page-auth')
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? `${locals.title} · Competency Hub` : 'Competency Hub' %></title>
  <meta name="description" content="<%= locals.description || 'Competency Hub: catálogo de competencias técnicas y conductuales del equipo de la consultora.' %>">
  <meta name="theme-color" content="#0F172A">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@300;400;500;600;700&display=swap">

  <link rel="stylesheet" href="/css/main.css">
</head>
<body<% if (locals.bodyClass) { %> class="<%= locals.bodyClass %>"<% } %>>
  <a class="skip-link" href="#main">Saltar al contenido</a>
  <%- include('navbar') %>
