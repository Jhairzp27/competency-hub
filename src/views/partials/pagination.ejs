<%#
  Partial: paginación accesible para listados.
  Uso (desde una vista):
    include('../partials/pagination', {
      page: 2, totalPages: 8, totalItems: 75, pageSize: 10,
      baseUrl: '/skills', query: { q: 'node', category: 'TECNICA' }
    })
  - query: filtros actuales; se conservan al cambiar de página (vacíos se omiten).
  - El número de página viaja como ?page=N.
%>
<%
  const pg = Math.max(1, parseInt(locals.page, 10) || 1);
  const pages = Math.max(1, parseInt(locals.totalPages, 10) || 1);
  const total = parseInt(locals.totalItems, 10) || 0;
  const size = parseInt(locals.pageSize, 10) || 10;
  const base = locals.baseUrl || '';

  const pageUrl = (n) => {
    const params = new URLSearchParams();
    Object.entries(locals.query || {}).forEach(([k, v]) => {
      if (v !== undefined && v !== null && v !== '' && k !== 'page') params.set(k, v);
    });
    params.set('page', n);
    return `${base}?${params.toString()}`;
  };

  // Ventana de páginas: primera, última y dos a cada lado de la actual
  const shown = [];
  for (let n = 1; n <= pages; n++) {
    if (n === 1 || n === pages || Math.abs(n - pg) <= 2) shown.push(n);
    else if (shown[shown.length - 1] !== '…') shown.push('…');
  }
  const from = total === 0 ? 0 : (pg - 1) * size + 1;
  const to = Math.min(pg * size, total);
%>
<div class="pagination-bar">
  <p class="pagination-summary">Mostrando <strong><%= from %>–<%= to %></strong> de <strong><%= total %></strong></p>
  <% if (pages > 1) { %>
  <nav class="pagination" aria-label="Paginación">
    <ul>
      <li>
        <% if (pg > 1) { %>
          <a class="pagination-link" href="<%= pageUrl(pg - 1) %>" rel="prev">
            <%- include('icon', { name: 'chevron-left', size: 18, label: null }) %><span class="pagination-text">Anterior</span>
          </a>
        <% } else { %>
          <span class="pagination-link is-disabled" aria-disabled="true">
            <%- include('icon', { name: 'chevron-left', size: 18, label: null }) %><span class="pagination-text">Anterior</span>
          </span>
        <% } %>
      </li>
      <% shown.forEach((n) => { %>
        <li>
          <% if (n === '…') { %>
            <span class="pagination-ellipsis" aria-hidden="true">…</span>
          <% } else if (n === pg) { %>
            <a class="pagination-link is-current" href="<%= pageUrl(n) %>" aria-current="page" aria-label="Página <%= n %>, actual"><%= n %></a>
          <% } else { %>
            <a class="pagination-link" href="<%= pageUrl(n) %>" aria-label="Página <%= n %>"><%= n %></a>
          <% } %>
        </li>
      <% }) %>
      <li>
        <% if (pg < pages) { %>
          <a class="pagination-link" href="<%= pageUrl(pg + 1) %>" rel="next">
            <span class="pagination-text">Siguiente</span><%- include('icon', { name: 'chevron-right', size: 18, label: null }) %>
          </a>
        <% } else { %>
          <span class="pagination-link is-disabled" aria-disabled="true">
            <span class="pagination-text">Siguiente</span><%- include('icon', { name: 'chevron-right', size: 18, label: null }) %>
          </span>
        <% } %>
      </li>
    </ul>
  </nav>
  <% } %>
</div>
