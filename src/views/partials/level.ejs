<%#
  Partial: indicador de nivel de 1 a 5 (no depende solo del color: incluye el número).
  Uso (desde una vista): include('../partials/level', { level: 3 })
%>
<% const lvl = Math.min(5, Math.max(0, parseInt(locals.level, 10) || 0)); %>
<span class="level" role="img" aria-label="Nivel <%= lvl %> de 5">
  <span class="level-dots" aria-hidden="true">
    <% for (let i = 1; i <= 5; i++) { %><span class="level-dot<%= i <= lvl ? ' is-filled' : '' %>"></span><% } %>
  </span>
  <span class="level-value" aria-hidden="true"><%= lvl %>/5</span>
</span>
